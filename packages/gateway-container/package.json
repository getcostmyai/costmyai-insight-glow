    "start": "node dist/packages/gateway-container/src/index.js",
    "dev": "node --experimental-strip-types src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "files": ["dist", "README.md", "CONNECT.md", "DECISIONS.md"],
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "5.9.2"
  }
}
